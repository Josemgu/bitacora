# Bitacora - Configuration
# Copy this file to .env and fill in your values

# Operating mode
# selfhost = keep provider keys in the browser (recommended for local use)
# hosted = store encrypted provider keys server-side
BITACORA_MODE=selfhost

# Database — leave empty for SQLite (local), or set PostgreSQL URL for homelab
# DATABASE_URL=postgresql://bitacora:password@db:5432/bitacora

# Security (required only in hosted mode)
# ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# AI Provider API Keys (optional, set only the ones you use)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# GitHub Personal Access Token (for repo management)
# GITHUB_TOKEN=ghp_...

# App settings
BITACORA_DB_PATH=./data/bitacora.db
TIMEZONE=America/Santo_Domingo
